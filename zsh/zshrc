# Bring "xterm" up to "xterm-256color", fairly well expected this should work
[[ "$TERM" == "xterm" ]] && export TERM="xterm-256color"

# kitty integration
if [[ -n "$KITTY_INSTALLATION_DIR" ]]; then
  export KITTY_SHELL_INTEGRATION="enabled"
  autoload -Uz -- "$KITTY_INSTALLATION_DIR"/shell-integration/zsh/kitty-integration
  kitty-integration
  unfunction kitty-integration
fi

# Directory this file really lives in (zsh/ in the dotfiles repo)
_zsh_dir=${${(%):-%x}:A:h}

typeset -U path
path=(~/.local/bin $path)

export EDITOR="vim"

# --- history ----------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_dups hist_ignore_space hist_verify

# --- general ----------------------------------------------------------------
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments no_beep

# --- completion -------------------------------------------------------------
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- keys -------------------------------------------------------------------
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search   '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search '^[OB' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line '^[[F' end-of-line '^[[3~' delete-char
bindkey '^[[1;5C' forward-word '^[[1;5D' backward-word

# --- prompt -----------------------------------------------------------------
#   $                                                       (local, in ~)
#   ~/f/second $                                            14s main* +2 -1
#   nexus:~/[6]/a/b/leaf 1 $
#   /etc #                                                  (root: all red)
#
# Exit status 130 (Ctrl-C) is treated as success.
#
# Anything from outside (dir names, branch names) only reaches the prompt by
# reference (${_prompt_*}), so prompt_subst never evaluates it; % is escaped.
#
# Git status runs in the background and fills in the right side when done.
zmodload zsh/datetime
autoload -Uz add-zsh-hook
setopt prompt_subst transient_rprompt
export VIRTUAL_ENV_DISABLE_PROMPT=1

# More parents than this collapse to [n], keeping the last few abbreviated
_prompt_max_parents=4
_prompt_keep_parents=2

_prompt_host=
[[ -n $SSH_CONNECTION ]] && _prompt_host='%m:'

# Sets _prompt_loc: "host:path " (with trailing space), or empty locally in ~
_prompt_path() {
  local p=$PWD out=/
  if [[ $p == / ]]; then
    out=/
  elif [[ $p == $HOME ]]; then
    out='~'
  else
    [[ $p == $HOME/* ]] && p=${p#$HOME/} out='~/'
    local -a parents=(${(s:/:)p})
    local leaf=${parents[-1]} d
    parents[-1]=()
    if (( $#parents > _prompt_max_parents )); then
      out+="[$(( $#parents - _prompt_keep_parents ))]/"
      parents=(${parents[-_prompt_keep_parents,-1]})
    fi
    for d in $parents; do
      [[ $d == .* ]] && out+=${d[1,2]}/ || out+=${d[1]}/
    done
    out+=$leaf
  fi

  if [[ -z $_prompt_host && $out == '~' ]]; then
    _prompt_loc=
  else
    _prompt_loc="${_prompt_host}${out//\%/%%} "
  fi
}

# Runs in the background; prints the formatted git segment (or nothing)
_prompt_git() {
  local gitdir
  gitdir=$(git rev-parse --git-dir 2>/dev/null) || return

  local -a st ab
  local line branch oid dirty state out
  st=("${(@f)$(git status --porcelain=v2 --branch 2>/dev/null)}")
  for line in $st; do
    case $line in
      '# branch.oid '*)  oid=${line#\# branch.oid } ;;
      '# branch.head '*) branch=${line#\# branch.head } ;;
      '# branch.ab '*)   ab=(${=line}) ;;
      '#'*|'') ;;
      *) dirty='*' ;;
    esac
  done
  [[ $branch == '(detached)' ]] && branch=${oid[1,7]}

  if [[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply ]]; then state=rebase
  elif [[ -f $gitdir/MERGE_HEAD ]]; then state=merge
  elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then state=cherry-pick
  elif [[ -f $gitdir/BISECT_LOG ]]; then state=bisect
  fi

  out="%F{8}${branch//\%/%%}${dirty}%f"
  [[ ${ab[3]} != (|+0) ]] && out+=" %F{cyan}${ab[3]}%f"
  [[ ${ab[4]} != (|-0) ]] && out+=" %F{cyan}${ab[4]}%f"
  [[ -n $state ]] && out+=" %F{yellow}($state)%f"
  print -r -- $out
}

_prompt_build_right() {
  local -a right
  [[ -n $_prompt_time ]] && right+=$_prompt_time
  [[ -n $_prompt_vcs ]] && right+=$_prompt_vcs
  _prompt_right=${(j: :)right}
}

_prompt_git_start() {
  _prompt_git_stop
  (( $+commands[git] )) || return
  exec {_prompt_git_fd}< <(_prompt_git)
  zle -F $_prompt_git_fd _prompt_git_done
}

_prompt_git_stop() {
  (( _prompt_git_fd )) || return
  zle -F $_prompt_git_fd
  exec {_prompt_git_fd}<&-
  _prompt_git_fd=0
}

_prompt_git_done() {
  local out
  IFS= read -r -u $1 out
  _prompt_git_stop
  [[ $out == $_prompt_vcs ]] && return
  _prompt_vcs=$out
  _prompt_build_right
  zle reset-prompt
}

_prompt_preexec() { _prompt_start=$EPOCHREALTIME }

# Leaving a repo shouldn't show its stale status while the new one loads
_prompt_chpwd() { _prompt_vcs= }

_prompt_precmd() {
  local -i elapsed=$(( ${EPOCHREALTIME} - ${_prompt_start:-$EPOCHREALTIME} ))
  unset _prompt_start
  _prompt_time=
  (( elapsed >= 5 )) && _prompt_time="%F{yellow}${elapsed}s%f"

  _prompt_path
  _prompt_build_right
  _prompt_git_start

  print -Pn "\e]0;%n@%m: %~\a"
}

typeset -gi _prompt_git_fd=0
add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd _prompt_precmd
add-zsh-hook chpwd _prompt_chpwd

if (( UID == 0 )); then
  PROMPT='%F{red}${_prompt_loc}%(?..%(130?..%? ))#%f '
else
  PROMPT='${_prompt_loc}%(?..%(130?..%F{red}%?%f ))%(?.%F{green}.%(130?.%F{green}.%F{red}))\$%f '
fi
RPROMPT='${_prompt_right}'

# --- aliases / functions ----------------------------------------------------
alias svim="sudoedit"
alias unlock="gpg -o /dev/null -s /dev/null"

function dotfiles-update() {
  git -C $_zsh_dir:h pull --recurse-submodules &&
    git -C $_zsh_dir:h submodule update --init --recursive
}

# --- plugins ----------------------------------------------------------------
# Vendored as submodules in zsh/plugins; missing ones are skipped
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
() {
  local plugins=$_zsh_dir/plugins p

  # fast-syntax-highlighting fetches this from GitHub on first load if it's
  # missing; seed it from the vendored copy so startup never hits the network
  local fsh_work=${FAST_WORK_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/fast-syntax-highlighting}
  if [[ -r $plugins/fast-syntax-highlighting/share/free_theme.zsh && ! -e $fsh_work/secondary_theme.zsh ]]; then
    mkdir -p $fsh_work && cp $plugins/fast-syntax-highlighting/share/free_theme.zsh $fsh_work/secondary_theme.zsh
  fi

  for p in zsh-autosuggestions fast-syntax-highlighting; do
    [[ -r $plugins/$p/$p.plugin.zsh ]] && source $plugins/$p/$p.plugin.zsh
  done
}

# --- kitty shell integration ------------------------------------------------
# nixpkgs patches kitty's shell_integration default to include "no-rc", so
# kitty never injects its own ZDOTDIR hook; it has to be loaded here instead.
# Without it kitty can't tell an idle prompt from a running command, so closing
# a window always asks "It is running: .../zsh".
if [[ -n "$KITTY_INSTALLATION_DIR" ]]; then
  export KITTY_SHELL_INTEGRATION="enabled"
  autoload -Uz -- "$KITTY_INSTALLATION_DIR"/shell-integration/zsh/kitty-integration
  kitty-integration
  unfunction kitty-integration
fi
